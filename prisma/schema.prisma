generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Business Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  senderEmail   String?   // Personalized @brancr.com email for outreach
  role          String    @default("researcher") // super_admin, researcher, outreach_operator, team_lead
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  assignments      Assignment[]
  createdComps     Company[]
  ownedLeads       Lead[]            @relation("LeadOwner")
  approvedLeads    Lead[]            @relation("LeadApprover")
  activityLogs     LeadActivityLog[]
  researchSessions ResearchSession[]
}

model Assignment {
  id     String @id @default(cuid())
  userId String
  region String?
  niche  String?
  status String @default("active")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  websiteUrl   String?
  linkedinUrl  String?
  location     String?
  niche        String?
  summary      String?
  source       String?
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy    User?    @relation(fields: [createdById], references: [id])
  sources      CompanySource[]
  leads        Lead[]
  contacts     Contact[]
}

model CompanySource {
  id                String   @id @default(cuid())
  companyId         String
  sourceUrl         String
  sourceType        String
  rawText           String?
  extractedMetadata String?
  fetchedAt         DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String   @id @default(cuid())
  companyId       String
  ownerId         String?
  stage           String   @default("new")
  priority        String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner           User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  approvedBy      User?    @relation("LeadApprover", fields: [approvedById], references: [id])
  analyses        AIAnalysis[]
  threads         OutreachThread[]
  activityLogs    LeadActivityLog[]
}

model AIAnalysis {
  id              String   @id @default(cuid())
  leadId          String
  fitScore        Int?
  confidenceScore Float?
  companySummary  String?
  painPoints      String?
  useCases        String?
  fitReasons      String?
  gapReasons      String?
  outreachAngle   String?
  rawResponse     String?
  modelName       String?
  createdAt       DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(cuid())
  companyId       String
  name            String?
  roleTitle       String?
  email           String?
  linkedinUrl     String?
  contactType     String?
  confidenceScore Float?
  sourceUrl       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  threads OutreachThread[]
}

model OutreachThread {
  id               String   @id @default(cuid())
  leadId           String
  contactId        String?
  channel          String   @default("email")
  status           String   @default("drafted")
  lastSentAt       DateTime?
  nextFollowUpAt   DateTime?

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])
  messages OutreachMessage[]
}

model OutreachMessage {
  id                 String   @id @default(cuid())
  threadId           String
  subject            String?
  body               String
  generatedByAi      Boolean  @default(false)
  reviewedByUser     Boolean  @default(false)
  sentAt             DateTime?
  providerMessageId  String?
  createdAt          DateTime @default(now())

  thread OutreachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model LeadActivityLog {
  id         String   @id @default(cuid())
  leadId     String
  actorId    String?
  actionType String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Task {
  id           String   @id @default(cuid())
  type         String
  entityId     String?
  status       String   @default("queued")
  attempts     Int      @default(0)
  payloadJson  String?
  scheduledFor DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
}

model ResearchSession {
  id            String   @id @default(cuid())
  userId        String
  region        String
  niche         String
  status        String   @default("pending") // pending | running | completed | failed
  totalFound    Int      @default(0)
  totalAnalyzed Int      @default(0)
  totalSkipped  Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  results ResearchResult[]
}

model ResearchResult {
  id        String  @id @default(cuid())
  sessionId String
  companyId String?
  leadId    String?
  name      String
  domain    String?
  status    String  // created | duplicate | failed
  note      String?

  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
